# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and must NOT be committed.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: the Claude/Anthropic key is NO LONGER a client variable.
# It lives server-side as a Supabase Function secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
